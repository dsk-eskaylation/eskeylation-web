# Sao chép thành .env và điền giá trị thật (KHÔNG commit .env)

# Supabase PostgreSQL — dùng connection pooler (PgBouncer), driver asyncpg
DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:6543/postgres

# Redis cho Celery
REDIS_URL=redis://localhost:6379/0

# Storage: local (dev) | supabase (prod)
STORAGE_BACKEND=local
# Thư mục media cục bộ (khi local)
MEDIA_ROOT=media

# Supabase Storage (khi STORAGE_BACKEND=supabase)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_KEY=<service_role_key>
STORAGE_BUCKET=media

# Drive API key chỉ dùng phía server, đọc thư mục công khai.
GOOGLE_DRIVE_API_KEY=
# Khi thư mục riêng tư: backend dùng service account được chia sẻ quyền Người xem.
# JSON credential chỉ lưu phía server, không đưa vào frontend hoặc Git.
GOOGLE_DRIVE_SERVICE_ACCOUNT_FILE=
# Website lấy catalog và proxy media từ Drive.
PUBLIC_CONTENT_SOURCE=drive
GOOGLE_DRIVE_FOLDER_ID=1lnfNK-1UMVLrydMHBntY33cLipf4MyFL
DRIVE_CATALOG_CACHE_SECONDS=300
DRIVE_STREAM_CONCURRENCY=16
DRIVE_IMAGE_CACHE_BYTES=33554432
DRIVE_MAX_IMAGE_BYTES=33554432

# JWT — đặt chuỗi bí mật ngẫu nhiên đủ dài cho production
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Môi trường: dev | prod
ENVIRONMENT=dev

# CORS — origin frontend, khai báo dạng JSON list
CORS_ORIGINS=["http://localhost:5173"]
